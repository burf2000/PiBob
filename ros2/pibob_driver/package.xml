<?xml version="1.0"?>
<package format="3">
  <name>pibob_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 driver bridging /joint_states to PiBob's Flask servo API.</description>
  <maintainer email="simon@burf.co">Simon Burfield</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>pibob_description</exec_depend>
  <!-- bring-up launch (RViz + sliders) -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
